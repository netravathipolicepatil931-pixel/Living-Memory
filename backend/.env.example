# ==================================================================
# LIVING MEMORY — Python FastAPI Backend Environment Template
# ==================================================================
# Copy to `backend/.env` OR root `/.env` when running locally in
# Antigravity. Both files are loaded automatically by
# `backend/app/core/config.py`. Leave placeholders empty here.
# ==================================================================

APP_ENV="development"
APP_URL="http://localhost:3000"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8088"
CORS_ORIGINS="http://localhost:3000"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_REASONING_MODEL="gemini-3.8-flash"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Google OAuth 2.0 (Gmail read-only + optional Calendar read-only)
GOOGLE_CLIENT_ID="242189333866-qkui7bem9pls497g5f62av2j6k4eck59.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# Supabase PostgreSQL + pgvector + Storage
SUPABASE_URL="https://miakkyleoufreliwbuun.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="living_memory-files"
DATABASE_URL=""

# Sarvam AI API
SARVAM_API_KEY=""
SARVAM_BASE_URL="https://api.sarvam.ai"

# Security & Token Encryption
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""
