# ==================================================================
# LIVING MEMORY — Python FastAPI Backend Environment Template
# ==================================================================
# Copy to `backend/.env` OR root `/.env` when running locally in
# Antigravity. Both files are loaded automatically by
# `backend/app/core/config.py`. Leave placeholders empty here.
# ==================================================================

APP_ENV=""
APP_URL=""
BACKEND_HOST=""
BACKEND_PORT=""
CORS_ORIGINS=""

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_REASONING_MODEL=""
GEMINI_TRANSCRIBE_MODEL=""
GEMINI_EMBEDDING_MODEL=""

# Google OAuth 2.0 (Gmail read-only + optional Calendar read-only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Supabase PostgreSQL + pgvector + Storage
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET=""
DATABASE_URL=""

# Sarvam AI API
SARVAM_API_KEY=""
SARVAM_BASE_URL=""

# Security & Token Encryption
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""
