# ==================================================================
# LIVING MEMORY — Root Environment Variables Template
# ==================================================================
# Copy this file to `.env` (or `.env.local`) when running locally in
# Antigravity, or configure these keys in your deployment Secrets UI.
# Keep all values empty in `.env.example`. Never commit real secrets.
# ==================================================================

# Application URL (used for OAuth redirect URI derivation & CORS)
APP_URL="http://localhost:3000"

# Express + Vite proxy port and internal FastAPI port
PORT="3000"
BACKEND_PORT="8088"

# Google Gemini API (AI extraction, embeddings, transcription, Ask AI)
GEMINI_API_KEY=""
GEMINI_REASONING_MODEL="gemini-3.8-flash"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Google OAuth 2.0 (Gmail read-only + optional Google Calendar read-only)
GOOGLE_CLIENT_ID="242189333866-qkui7bem9pls497g5f62av2j6k4eck59.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# Supabase PostgreSQL + pgvector + Storage (optional; uses local SQLite if unset)
SUPABASE_URL="https://miakkyleoufreliwbuun.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="living_memory-files"

# Sarvam AI API (optional multilingual Indian STT, translation, TTS)
SARVAM_API_KEY=""

# Backend Security Secrets (Fernet token encryption key & JWT signing key)
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""
